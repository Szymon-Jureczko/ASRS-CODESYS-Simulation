            <Single Name="TextBlobForSerialisation" Type="string">{attribute 'qualified_only'}
VAR_GLOBAL
    // A 5x5 grid of storage locations
    arrWarehouse : ARRAY[1..5, 1..5] OF ST_WarehouseSlot;
    
    // Physical Crane Positions (0.0 to 500.0 pixels for HMI)
    rCraneX_Actual : REAL := 0.0;
    rCraneY_Actual : REAL := 0.0;
    rTargetX : REAL; // Calculated X position for the crane
    rTargetY : REAL; // Calculated Y position for the crane
    // Command Variables
    iTargetRow : INT := 1;
    iTargetCol : INT := 1;
	xManualExecute : BOOL;
    xExecute   : BOOL;
iIncomingType : INT;
sIncomingName : STRING;
xBoxReady     : BOOL;
xSystemFull   : BOOL;
rPickX        : REAL := 39.0;  // Coordinates for bottom-left dock
rPickY        : REAL := 452.0;
// ANIMATION VARIABLES
    rActiveBoxX : REAL;    // The moving box's X position
    rActiveBoxY : REAL;    // The moving box's Y position
    xCarrying   : BOOL;    // TRUE when gripper is holding the box
    
    // HOME POSITION (Where crane returns)
    rHomeX      : REAL := 50.0;
    rHomeY      : REAL := 50.0;
END_VAR</Single>
